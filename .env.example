# App URL and secrets. Generate 32 random bytes for each base64 value.
NEXT_PUBLIC_APP_URL=http://localhost:3010
DREAM_ENCRYPTION_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES
DREAM_HMAC_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES

# Fixed server-verified accounts used for PG review. Passwords must be stored
# only as independent scrypt hashes: scrypt$<base64url salt>$<base64url 32-byte key>
REVIEW_AUTH_IDENTIFIER=
REVIEW_AUTH_PASSWORD_HASH=
REVIEW_AUTH_SECONDARY_IDENTIFIER=
REVIEW_AUTH_SECONDARY_PASSWORD_HASH=
REVIEW_AUTH_SECRET=

# Canonical public seller disclosure. Keep every public deployment identical.
BUSINESS_NAME=노드오프
BUSINESS_REPRESENTATIVE=진동현
BUSINESS_REGISTRATION_NUMBER=502-60-03676
BUSINESS_ADDRESS=인천광역시
BUSINESS_PHONE=
BUSINESS_EMAIL=jin@nodeoff.kr
MAIL_ORDER_REGISTRATION_NUMBER=

# Runtime profile controls AI and storage defaults. Local development uses
# Codex; PAYMENTS_MODE can choose the payment provider independently.
# review: rule-based interpretation + mock payment + review-only memory fallback
# local-ai: local Codex CLI; explicit PAYMENTS_MODE selects the payment provider
# production: OpenAI + explicit live provider (Toss by default); no mock payments
APP_PROFILE=local-ai

# AI_MODE=codex uses this Mac's signed-in Codex CLI and ChatGPT subscription.
# It uses this Mac's signed-in Codex CLI and is blocked whenever VERCEL is set.
# AI_MODE=openai uses the API key. Without a working provider, free answers use
# a marked local fallback only when AI is not required; paid generation remains
# in an explicit retry state.
AI_MODE=codex
OPENAI_API_KEY=
OPENAI_FREE_MODEL=gpt-5-mini
OPENAI_PAID_MODEL=gpt-5.4-mini
# OpenAI-path reasoning effort defaults to "low". Raise it toward the local
# Codex quality bar at higher latency and token cost. Per-operation overrides
# fall back to OPENAI_REASONING_EFFORT.
# OPENAI_REASONING_EFFORT=low
# OPENAI_ANALYSIS_REASONING_EFFORT=
# OPENAI_FREE_REASONING_EFFORT=high
# OPENAI_DETAILED_REASONING_EFFORT=high
# OPENAI_FOLLOWUP_REASONING_EFFORT=
# Per-call timeout override in ms; raise together with higher reasoning effort.
# OPENAI_TIMEOUT_MS=
# OPENAI_FREE_TIMEOUT_MS=
# OPENAI_DETAILED_TIMEOUT_MS=
CODEX_LOCAL_ENABLED=false
CODEX_CLI_PATH=codex
# Local development baseline for high-quality Korean interpretation. Override
# these values when faster, lower-cost iteration is more important than quality.
CODEX_LOCAL_MODEL=gpt-6-luna
CODEX_LOCAL_REASONING_EFFORT=high
# Prompt-lab proposal overrides only; does not change dream analysis.
CODEX_LOCAL_PROMPT_EDIT_MODEL=gpt-6-astra
CODEX_LOCAL_PROMPT_EDIT_REASONING_EFFORT=medium
# Optional per-operation overrides when one stage should iterate faster than
# the writing calls. Unset operations fall back to CODEX_LOCAL_REASONING_EFFORT.
# CODEX_LOCAL_ANALYSIS_REASONING_EFFORT=low
# CODEX_LOCAL_FREE_REASONING_EFFORT=
# CODEX_LOCAL_DETAILED_REASONING_EFFORT=
# CODEX_LOCAL_FOLLOWUP_REASONING_EFFORT=
CODEX_LOCAL_TIMEOUT_MS=300000
# Optional codex bridge transport (self-hosted). When set, generation calls go
# to the sidecar over HTTP instead of spawning the CLI in-process.
# CODEX_BRIDGE_URL=
# CODEX_BRIDGE_TOKEN=

# Optional password gate before dream interpretation (shared-secret demo lock).
# ACCESS_GATE_PASSWORD_HASH=scrypt$<base64url salt>$<base64url 32-byte key>
# ACCESS_GATE_SECRET=

# Local payments are mock-only. A Vercel Preview may explicitly enable a
# non-charging walkthrough with ALLOW_MOCK_PAYMENTS=true. Vercel or self-hosted
# Production additionally requires PUBLIC_DEMO_MODE=true, and the UI must keep
# the no-charge label visible.
# Real payments require PortOne LIVE channel/API/webhook secrets or Toss keys.
PAYMENTS_MODE=mock
# PAYMENTS_MODE=portone keeps the AI profile unchanged and uses NHN KCP V2.
# Only LIVE receipts from this store/channel are accepted. No secrets are public.
PORTONE_STORE_ID=
PORTONE_KCP_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false
PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Persistence. Local development uses SQLite. The first Vercel deployment must
# use DREAM_REPOSITORY=supabase; production never falls back to memory.
DREAM_REPOSITORY=sqlite
DREAM_DATABASE_PATH=.data/kkumgyeol.sqlite3
# Durable paid worker on a long-running SQLite origin (not Vercel serverless).
PAID_GENERATION_JOBS=false
# UI experiments only. Never enable for paid or production traffic.
ALLOW_EPHEMERAL_MEMORY=false

# Optional Supabase persistence and Kakao/Google OAuth. Use a separate project for this service.
# Apply every file in supabase/migrations/ before setting DREAM_REPOSITORY=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
